# Copy to .env and fill in. .env is gitignored and must never be committed (SOP-040 §1).
# If a key is ever committed, rotate it immediately -- git history is public.

# NVIDIA API Catalog (build.nvidia.com) -- free endpoints, OpenAI-compatible
# Base URL: https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=

# GMI Cloud -- paid credit, used only where NVIDIA lacks a needed model
GMI_API_KEY=
