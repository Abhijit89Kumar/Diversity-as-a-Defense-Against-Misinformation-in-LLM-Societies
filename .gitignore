# ---- Secrets. Never commit. ----
.env
.env.*
!.env.example
*.key
*.pem
credentials.json
secrets/

# ---- Data ----
# Raw and interim data are large and go to a release / HF dataset / Zenodo (SOP-050 §4).
# Keep the directory structure, not the contents.
data/raw/*
data/interim/*
data/processed/*
data/annotations/*
!data/**/.gitkeep
!data/**/README.md
!data/**/*.schema.json

# Small, citable derived tables may be force-added deliberately:
#   git add -f data/processed/summary_table.csv

# ---- Results ----
results/**/*.png
results/**/*.pdf
results/**/*.svg
!results/**/README.md
# Figures that appear in the paper are tracked under docs/05-paper/figures/

# ---- Python ----
__pycache__/
*.py[cod]
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
.python-version

# ---- Tooling caches ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/
.hypothesis/

# ---- Modal / vLLM ----
.modal/
*.safetensors
*.gguf
models/
hf_cache/

# ---- Editors / OS ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---- LaTeX ----
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc

# ---- Scratch ----
scratch/
tmp/
*.tmp
